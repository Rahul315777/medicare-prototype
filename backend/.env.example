# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's already in your actual repo — make
# sure .gitignore excludes it, and rotate any key that leaked into git history).

# ── App ──────────────────────────────────────────────────
APP_NAME=MediCare AI
DEBUG=true

# ── Security ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (SQLite for local dev, no Docker needed) ────
DATABASE_URL=sqlite+aiosqlite:///./medicare.db
DATABASE_URL_SYNC=sqlite:///./medicare.db

# ── Redis (required — used for refresh-token sessions AND OTP storage) ──
REDIS_URL=redis://localhost:6379/0

# ── OpenAI (optional, only if you use OpenAI embeddings/models elsewhere) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Groq (required — powers the medical chatbot LLM + report/vision analysis) ──
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Google OAuth (required only for the "Sign in with Google" button) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Maps (optional — doctor location features) ────
GOOGLE_MAPS_API_KEY=

# ── Email / SMTP (optional — used for OTP verification + password reset emails)
# If left blank, OTPs are logged to the server console instead of emailed
# (safe for local development; configure real SMTP before production).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MediCare AI
SMTP_TLS=true

# ── Storage ──────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Cloudinary (optional, only if STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (optional, only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ── Vector DB ────────────────────────────────────────────
# The FAISS medical-knowledge index and per-user long-term memory both live
# under UPLOAD_DIR automatically (faiss_medical_index/, user_memory/) —
# nothing extra to configure for them.
VECTOR_DB=faiss
CHROMA_PERSIST_DIR=./chroma_data

# Pinecone (optional, only if VECTOR_DB=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=

# ── Frontend Connection ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
